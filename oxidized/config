---
username: username
password: password
model: junos
resolve_dns: true
interval: 3600
debug: false
#log: "/root/.config/oxidized/logs/oxidized.log"
logger:
# level: :trace
  appenders:
    - type: syslog
      level: info
    - type: file
      file: "/root/.config/oxidized/logs/info.log"
run_once: false
threads: 30
use_max_threads: true
timeout: 20
timelimit: 300
retries: 3
prompt: !ruby/regexp /^([\w.@-]+[#>]\s?)$/
next_adds_job: false
vars: {}
groups: 
  hudong1:
    username: 
    password: 
    vars:
      enable: 
  hudong2:
    username: 
    password: 
  wan:
    username: 
    password: 
group_map: {}
models: {}
pid: "/root/.config/oxidized/pid"
extensions:
  oxidized-web:
    load: true
    port: 8080
    listen: 0.0.0.0
    url_prefix: roc
crash:
  directory: "/root/.config/oxidized/crashes"
  hostnames: false
stats:
  history_size: 10
input:
  default: ssh, telnet
  debug: false
  ssh:
    secure: false
  ftp:
    passive: true
  utf8_encoded: true
output:
  default: file
  file:
    directory: "/root/.config/oxidized/configs"
source:
  default: csv
  csv:
    file: "/root/.config/oxidized/router.db"
    delimiter: !ruby/regexp /:/
    map:
      name: 0
      ip: 1
      model: 2
      group: 3
    gpg: false
model_map:
  juniper: junos
  cisco: ios
